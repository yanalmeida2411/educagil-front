# ---------------------------------------------------------------------------
# Frontend (Next.js) — copie para .env.local e ajuste conforme o seu ambiente.
# Variáveis NEXT_PUBLIC_* são expostas ao browser: nunca coloque segredos aqui.
# ---------------------------------------------------------------------------

# URL base da API Go. Em desenvolvimento o backend sobe via docker compose.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Nome exibido da aplicação (usado em títulos e metadados).
NEXT_PUBLIC_APP_NAME=Educagil
