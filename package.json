{
  "name": "front-educagil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:test:env": "next dev --turbopack --port 9999",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "cypress:web": "npx cypress open",
    "cypress:headless": "npx cypress run",
    "test:e2e": "npx concurrently \"npm run dev:test:env\" \"npx wait-on http://localhost:9999 && npm run cypress:headless\"",
    "test:e2e:web": "npx concurrently \"npm run dev:test:env\" \"npx wait-on http://localhost:9999 && npm run cypress:web\""
  },
  "dependencies": {
    "@next/font": "^14.2.15",
    "axios": "^1.9.0",
    "cross-env": "^7.0.3",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "next": "^15.3.9",
    "nookies": "^2.5.2",
    "path": "^0.12.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.5.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.4",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/axios": "^0.9.36",
    "@types/cypress": "^0.1.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.46",
    "@types/react-dom": "^19",
    "@types/testing-library__react": "^10.0.1",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "cypress": "^14.3.3",
    "esbuild": "^0.25.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  }
