{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "preserve",
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "composite": true,
    "resolveJsonModule": true,
    "types": [
      "cypress",
      "jest",
      "@testing-library/jest-dom"
    ],
    "outDir": "dist",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    ".next/types//*.ts",
    "/*.ts",
    "/*.tsx",
    "cypress.config.js",
    "cypress/**/*.ts",
    "cypress/**/*.tsx",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src//*.test.ts",
    "src//*.test.tsx",
    "src//*.ts",
    "src//*.tsx",
    "tests/**/*.ts",
    ".next/types/**/*.ts"
, "src/services/api"  ],
  "exclude": [
    "node_modules"
  ],
}